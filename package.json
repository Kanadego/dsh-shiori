{
  "name": "dsh-shiori",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的分层记忆插件：L0 人设卡常驻、L1 记忆核心+派生索引每轮注入、L2 Spark 卡片按触发词浮回、L3 专题按需展开，配套整理/遗忘与原生 web 面板。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanadego/dsh-shiori.git"
  },
  "homepage": "https://github.com/Kanadego/dsh-shiori",
  "bugs": {
    "url": "https://github.com/Kanadego/dsh-shiori/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "persona",
    "sparks",
    "system-prompt"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "icon": "./icon.png",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "node": ">=24",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "files": [
    "index.mjs",
    "icon.png",
    "src",
    "client",
    "cordis.patch.yml",
    "docs/plugin/INSTALL.md",
    "docs/plugin/client.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/core/*.test.mjs test/host/*.test.mjs test/storage/*.test.mjs test/service/*.test.mjs test/integration/*.test.mjs test/runtime/*.test.mjs test/completion/*.test.mjs test/acceptance/*.test.mjs test/sparks/*.test.mjs test/organize/*.test.mjs test/forgetting/*.test.mjs test/plugin/*.test.mjs",
    "test:p5": "node --test test/plugin/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:integration": "node --test test/service/*.test.mjs test/integration/*.test.mjs",
    "test:p1": "node --test test/runtime/*.test.mjs test/completion/*.test.mjs test/acceptance/*.test.mjs",
    "test:p3": "node --test test/organize/*.test.mjs",
    "test:p4": "node --test test/forgetting/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0 || ^19.0.0"
  },
  "license": "CC-BY-NC-SA-4.0"
}
